<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the languages of the web app: the web view reports the phone's language to the app (navigator.language)
	     only when the app declares it; the rest of the Info.plist is generated by Xcode -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
		<string>es</string>
		<string>sv</string>
		<string>nb</string>
	</array>
</dict>
</plist>
